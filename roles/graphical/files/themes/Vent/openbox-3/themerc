window.active.button.max.pressed.image.color: #5f7f5f
window.active.button.close.pressed.image.color: #bc6c4c
window.active.button.shade.pressed.image.color: #46bae0
window.active.button.desk.pressed.image.color: #f6bfc5

# Inactive window buttons (Normal State: darker out-of-focus grey)
