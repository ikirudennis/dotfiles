# set XDG_CURRENT_DESKTOP to wlroots, with sway as a fallback. This allows
# flameshot to work properly
XDG_CURRENT_DESKTOP=wlroots:sway
LC_COLLATE=C

#XKB_DEFAULT_OPTIONS=caps:swapescape,shift:both_capslock_cancel

QT_QPA_PLATFORMTHEME=qt5ct

# cursor size changes between X apps and wayland. Setting it here keeps it
# consistent across apps
XCURSOR_SIZE=24

# The PATH doesn't use my zsh config. Adding the local bin to the front allows
# commands installed there to show up in bemenu-run. And the path also includes
# the path where flatpaks are installed so that they can be launched from
# bemenu-run as well.
PATH=~/.local/bin:${PATH}:/var/lib/flatpak/exports/bin

# for neovim-qt to recognize the perl neovim module, it needs the following
# environment variables, which are typically set by an `eval $(perl
# -I$HOME/.local/perl5/lib/perl5 -Mlocal::lib=$HOME/.local/perl5)"` command
PERL5LIB=/home/dburke/.local/perl5/lib/perl5
PERL_LOCAL_LIB_ROOT=/home/dburke/.local/perl5
PERL_MB_OPT=--install_base "/home/dburke/.local/perl5"
PERL_MM_OPT=INSTALL_BASE=/home/dburke/.local/perl5

BEMENU_OPTS=--bottom --ignorecase --hp 5 --nb '#151617' --nf '#d8d8d8' --sb '#d8d8d8' --sf '#151617' --tf '#005577' --tb '#151617' --hf '#d8d8d8' --hb '#005577'

# set a default terminal to use when labwc attempts to start CLI apps defined
# in .desktop files
TERMINAL=foot

# nvim-qt wants $TERM to be set for terminal usage
TERM=rxvt-unicode-256color